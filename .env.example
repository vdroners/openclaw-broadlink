# Copy keys into ~/.openclaw/.env (never commit real secrets)
OPENCLAW_AGENT_MENTION=@openclaw

# Broadlink RM Max / local IR+RF (see docs/BROADLINK-RM-MAX.md)
BROADLINK_ENABLED=0
BROADLINK_ACTUATION_ENABLED=0
BROADLINK_REQUIRE_TALK_CONFIRM=1
BROADLINK_RF_ENABLED=0
BROADLINK_HOST=10.0.0.174
BROADLINK_MAC=34:8e:89:b1:10:2a
BROADLINK_TYPE=0xaf8b
BROADLINK_NICKNAME=rm-max
BROADLINK_VENV=~/.openclaw/venv-broadlink
BROADLINK_DEVICES_JSON=~/.openclaw/config/broadlink-devices.json
BROADLINK_CODES_DIR=~/.openclaw/state/broadlink-codes
# Optional loopback HTTP façade — never use 8790 (forge owns it)
# BROADLINK_BRIDGE_URL=http://127.0.0.1:18792
