{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vdroners.local/schemas/broadlink-devices.json",
  "title": "BroadlinkDevices",
  "type": "object",
  "required": ["schema_version", "default_device", "devices"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "default_device": { "type": "string", "minLength": 1 },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "host", "mac", "type"],
        "properties": {
          "id": { "type": "string" },
          "nickname": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "host": { "type": "string" },
          "mac": { "type": "string", "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$" },
          "type": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" },
          "model": { "type": "string" },
          "discovery_name": { "type": "string" },
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "enum": ["ir", "rf"] }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
